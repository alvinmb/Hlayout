__pycache__/
*.pyc
_to_delete/
hlayout_proj/
hlayout_project.zip

# Local PyInstaller/installer build output (packaging/windows/build.ps1,
# packaging/linux/build.sh) -- CI produces these fresh on its own
# runners, so a locally-built copy should never get committed.
/build/
/dist/
/dist-installers/

# Output of the examples/ generator scripts -- regenerated on demand
# (and by their tests); the scripts are the source of truth, not these.
/examples/*.gds
/examples/*.gds.hlaux

# Hybrid router: the Freerouting checkout is its own repo (upstream 5aa1b24 +
# router/freerouting-overlay copied in); only the overlay is tracked here.
/router/freerouting/
/router/examples/win_run/
# Router hand-off packages and scratch output
/hlayout-router-phase*.zip
/router_phase4.zip
/hlayout/examples/freerouting/
# Editor backups left by manual/design edits
*.bak
*.bak[0-9]
*.bak_*

# Save backups kept by File > Save (NAME.bak1..3.gds + sidecars) and routing scratch
*.bak[0-9].gds
*.bak[0-9].gds.hlaux
example5/_frtest/
hang_traceback.txt
_upload/

# KiCad local history (its own git repo)
.history/
