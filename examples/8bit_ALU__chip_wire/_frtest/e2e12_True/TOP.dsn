(pcb VIATEST_TOP
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "HLayout")
    (host_version "1")
  )
  (resolution um 1)
  (unit um)
  (structure
    (layer L5 (type signal) (property (index 0)))
    (layer L3 (type signal) (property (index 1)))
    (boundary (path pcb 0  0 0  20000 0  20000 20000  0 20000  0 0))
    (via VIA_SIG VIA_PWR)
    (rule (width 300) (clearance 100))
    (snap_angle ninety_degree)
    (autoroute_settings (autoroute on) (postroute on) (vias on) (via_costs 2))
  )
  (placement
    (component IMG_IO (place IO 0 0 front 0))
  )
  (library
    (image IMG_IO
      (pin PAD_L3_800x800 1 1500 3000)
      (pin PAD_L3_800x800 2 18500 17000)
      (pin PAD_L3_800x800 3 3000 1500)
      (pin PAD_L3_800x800 4 17000 18500)
      (pin PAD_L3_800x800 5 1500 5500)
      (pin PAD_L3_800x800 6 18500 14500)
      (pin PAD_L3_800x800 7 5500 1500)
      (pin PAD_L3_800x800 8 14500 18500)
      (pin PAD_L3_800x800 9 1500 8000)
      (pin PAD_L3_800x800 10 18500 12000)
      (pin PAD_L3_800x800 11 8000 1500)
      (pin PAD_L3_800x800 12 12000 18500)
      (pin PAD_L3_800x800 13 1500 10500)
      (pin PAD_L3_800x800 14 18500 9500)
      (pin PAD_L3_800x800 15 10500 1500)
      (pin PAD_L3_800x800 16 9500 18500)
      (pin PAD_L3_800x800 17 1500 13000)
      (pin PAD_L3_800x800 18 18500 7000)
      (pin PAD_L3_800x800 19 13000 1500)
      (pin PAD_L3_800x800 20 7000 18500)
      (pin PAD_L3_800x800 21 1500 15500)
      (pin PAD_L3_800x800 22 18500 4500)
      (pin PAD_L3_800x800 23 15500 1500)
      (pin PAD_L3_800x800 24 4500 18500)
    )
    (padstack PAD_L3_800x800 (shape (rect L3 -400 -400 400 400)) (attach off))
    (padstack VIA_SIG
      (shape (rect L5 -200 -200 200 200))
      (shape (rect L3 -200 -200 200 200))
      (attach off))
    (padstack VIA_PWR
      (shape (rect L5 -350 -350 350 350))
      (shape (rect L3 -350 -350 350 350))
      (attach off))
  )
  (network
    (net H0 (pins IO-1 IO-2))
    (net H2 (pins IO-10 IO-9))
    (net V2 (pins IO-11 IO-12))
    (net H3 (pins IO-13 IO-14))
    (net V3 (pins IO-15 IO-16))
    (net H4 (pins IO-17 IO-18))
    (net V4 (pins IO-19 IO-20))
    (net H5 (pins IO-21 IO-22))
    (net V5 (pins IO-23 IO-24))
    (net V0 (pins IO-3 IO-4))
    (net H1 (pins IO-5 IO-6))
    (net V1 (pins IO-7 IO-8))
    (class HL_SIGNAL H0 H2 V2 H3 V3 H4 V4 H5 V5 V0 H1 V1
      (circuit (use_via VIA_SIG))
      (rule (width 300) (clearance 100)))
  )
  (wiring
  )
)
