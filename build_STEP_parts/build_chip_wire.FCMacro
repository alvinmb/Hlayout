"""HLayout chip-and-wire parts: coloured 3D STEP models for the
chip_wire library's ceramic chip capacitors (CAP_0201 ... CAP_2512),
the LM741 (uA741) bare die and the 20-, 30- and 40-pin hybrid header
packages (20_PIN_pkg, 30_PIN_pkg, 40_PIN_pkg -- same 2.54 mm pitch,
20.86 mm row spacing and well, only the length grows).

Each model's origin is its HLayout cell's own origin, so a placed
instance lines up with its 2D footprint (X/Y in mm, Z up):
  * caps   -- terminal/body outline from the cell, sitting on conductive
              epoxy dots (the cell's epoxy layer) 30 um thick at Z=0;
  * LM741  -- 1.1 x 1.1 x 0.38 mm silicon die on a 25 um silver-epoxy
              attach, 7 aluminium bond pads at the cell's pad positions;
  * header -- Kovar (nickel-plated) bathtub package, 1.0 mm floor and a
              6.0 mm deep well, 0.5 mm fillets on every edge (inside and
              outside corners, rim, well floor and bottom surface); Z=0 is the TOP of the floor (the well
              bottom, where the substrate sits). Gold pins (0.63 mm) pass
              through green glass seals (1.61 mm) in the floor, stand
              0.75 mm proud of the floor inside the well, and run 6.35 mm
              below the package.

Colours are written into the STEP files, so this has to run with the
FreeCAD GUI layer loaded -- headless is fine:
    set QT_QPA_PLATFORM=offscreen
    freecadcmd build_step_models.FCMacro
or Macro > Macros... > Execute inside FreeCAD."""
import os
import FreeCAD as App
import FreeCADGui as Gui
import Part

if not hasattr(Gui, "getMainWindow") or Gui.getMainWindow() is None:
    Gui.showMainWindow()
import ImportGui

V = App.Vector
# this script lives in <HLayout>/build_STEP_parts; the STEP files go to
# <HLayout>/examples/step_models/chip_wire wherever it is run from
_ROOT = (os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
         if "__file__" in globals() else os.getcwd())
# HLAYOUT_STEP_DIR (set by build_all.py) overrides where the STEP files go
OUT_DIR = os.path.join(os.environ.get("HLAYOUT_STEP_DIR") or os.path.join(_ROOT, "examples", "step_models"), "chip_wire")

